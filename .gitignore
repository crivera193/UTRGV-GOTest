# Local VS Code settings
.vscode/
supabase/.temp/

# Local character authoring workspace: dense meshes, Blender checkpoints,
# generated textures/renders and historical experiments. Runtime game exports
# belong under assets/ and must be reviewed and added deliberately.
/SourceArt/
/assets/character-references/

# Local character-authoring adapters (not Flutter/Flame application tooling).
/tool/mascot_*.py
/tool/human_cowboy_*.py
/tool/cowboy_*.py

